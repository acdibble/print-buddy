{
  "name": "print-buddy",
  "version": "0.3.0",
  "description": "ESC/POS thermal printer library for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p src/__tests__",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "keywords": [
    "print-buddy",
    "escpos",
    "thermal-printer",
    "pos",
    "receipt",
    "usb"
  ],
  "author": "Andrew Dibble <andrew@dibble.codes>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acdibble/print-buddy"
  },
  "bugs": {
    "url": "https://github.com/acdibble/print-buddy/issues"
  },
  "homepage": "https://github.com/acdibble/print-buddy#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "usb": "^2.19.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
