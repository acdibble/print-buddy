{
  "name": "print-buddy",
  "version": "0.2.2",
  "description": "ESC/POS thermal printer library for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "keywords": [
    "print-buddy",
    "escpos",
    "thermal-printer",
    "pos",
    "receipt",
    "usb"
  ],
  "author": "Andrew Dibble <andrew@dibble.codes>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acdibble/print-buddy"
  },
  "bugs": {
    "url": "https://github.com/acdibble/print-buddy/issues"
  },
  "homepage": "https://github.com/acdibble/print-buddy#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "usb": "^2.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.6.2",
  "lint-staged": {
    "*.ts": "eslint",
    "*.{ts,js,json,md,yml}": "prettier --write"
  }
}
